{
    "name": "lagdo/dbadmin-demo",
    "type": "application",
    "description": "Simple demo for the Jaxon DbAdmin Database management dashboard",
    "authors": [
        {
            "name": "Thierry Feuzeu",
            "email": "thierry.feuzeu@gmail.com"
        }
    ],
    "homepage": "https://github.com/lagdo/dbadmin-demo",
    "license": "Apache-2.0",
    "keywords": ["Database", "Admin", "Sql", "Dashboard", "Jaxon", "Ajax", "PostgreSQL", "MySQL", "Sqlite"],
    "support": {
        "issues": "https://github.com/lagdo/dbadmin-demo/issues",
        "source": "https://github.com/lagdo/dbadmin-demo"
    },
    "repositories": {
        "itk-dev/azure-key-vault-php": {
            "type": "vcs",
            "url": "https://github.com/feuzeu/AzureKeyVaultPhp"
        }
    },
    "require": {
        "php": ">=8.1.0",
        "lagdo/ui-builder-bootstrap5": "0.12.*",
        "lagdo/dbadmin-driver-mysql": "0.23.*",
        "lagdo/dbadmin-driver-pgsql": "0.23.*",
        "lagdo/dbadmin-driver-sqlite": "0.23.*",
        "lagdo/jaxon-dbadmin": "0.35.*",
        "alibabacloud/kms-20160120": "^2.0",
        "aws/aws-sdk-php": "^3.379",
        "csharpru/vault-php": "^4.4",
        "google/cloud-secret-manager": "^2.3",
        "infisical/php-sdk": "^0.0.2",
        "itk-dev/azure-key-vault-php": "dev-main",
        "vlucas/phpdotenv": "^5.4.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

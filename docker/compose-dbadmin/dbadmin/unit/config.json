{
    "listeners": {
        "*:8080": {
            "pass": "routes"
        }
    },

    "routes": [
        {
            "match": {
                "uri": "~^/.*php(.*)?$"
            },
            "action": {
                "pass": "applications/dbadmin"
            }
        },
        {
            "match": {
                "uri": "/*"
            },
            "action": {
                "share": "/var/www/dbadmin-demo/public$uri",
                "fallback": {
                    "pass": "applications/dbadmin"
                }
            }
        }
    ],

    "applications": {
        "dbadmin": {
            "type": "php",
            "processes": {
                "max": 5,
                "spare": 2,
                "idle_timeout": 30
            },
            "root": "/var/www/dbadmin-demo/public/"
        }
    }
}
